{
	"name": "open-in-git-tower-button",
	"displayName": "Open in Git Tower Button",
	"version": "1.0.8",
	"private": true,
	"description": "Open the current repository in the Tower Git client via a button in the VS Code status bar.",
	"categories": [
		"Other"
	],
	"keywords": [
		"vscode",
		"vsc",
		"extension",
		"git",
		"tower"
	],
	"homepage": "https://github.com/kitschpatrol/vscode-open-in-git-tower-button#readme",
	"bugs": {
		"url": "https://github.com/kitschpatrol/vscode-open-in-git-tower-button/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/vscode-open-in-git-tower-button.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"publisher": "kitschpatrol",
	"type": "commonjs",
	"main": "./dist/extension.js",
	"files": [
		"dist",
		"res",
		"LICENSE.txt"
	],
	"scripts": {
		"build": "tsc -p ./tsconfig.build.json",
		"clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"pack": "pnpm build && vsce package --no-dependencies",
		"release": "bumpp --commit 'Release: %s' && pnpm build && vsce publish --no-dependencies --no-update-package-json --no-git-tag-version --pat $(op read 'op://Personal/Azure VS Code/credential')",
		"test": "echo \"No tests specified\" && exit 0"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"devDependencies": {
		"@kitschpatrol/shared-config": "^7.6.2",
		"@types/node": "18.15.11",
		"@types/vscode": "1.93.0",
		"@vscode/vsce": "^3.9.1",
		"bumpp": "^11.1.0",
		"shx": "^0.4.0",
		"typescript": "~5.8.3"
	},
	"extensionPack": [
		"fabiospampinato.vscode-open-in-gittower"
	],
	"packageManager": "pnpm@11.1.2",
	"engines": {
		"node": ">=18.15.11",
		"vscode": "^1.93.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.22.2"
		}
	},
	"icon": "res/icon.png"
}
